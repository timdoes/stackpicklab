---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';

const posts = [
  {
    slug: 'jasper-vs-copyai-vs-writesonic-2026',
    title: 'Jasper vs Copy.ai vs Writesonic (2026)',
    description: 'A research-based comparison of three popular AI writing platforms for lean teams.',
    date: '2026-08-01',
  },
  {
    slug: 'best-surfer-seo-alternatives-budget',
    title: 'Best Surfer SEO Alternatives for Content Teams on a Budget',
    description: 'Cheaper paths to content optimization when Surfer is more than you need.',
    date: '2026-08-02',
  },
  {
    slug: 'semrush-vs-surfer-seo',
    title: 'Semrush vs Surfer SEO: Do You Need Both for Blog Content?',
    description: 'When a full SEO suite and a content optimizer overlap—and when they don’t.',
    date: '2026-08-03',
  },
  {
    slug: 'best-ai-writing-tools-under-100',
    title: 'Best AI Writing Tools for Small Marketing Teams (Under $100/mo)',
    description: 'Lean-budget AI writing picks for small marketing teams—as of August 2026.',
    date: '2026-08-04',
  },
  {
    slug: 'frase-vs-surfer-2026',
    title: 'Frase vs Surfer: Which Content Optimizer Wins for SEO in 2026?',
    description: 'Briefs and speed versus deeper on-page optimization—research-based tradeoffs.',
    date: '2026-08-05',
  },
  {
    slug: 'copyai-workflows-b2b-outbound',
    title: 'Copy.ai Workflows for B2B Outbound (Honest Research-Based Setup Guide)',
    description: 'Docs- and research-based workflow setup for B2B outbound—not a fabricated long-term trial.',
    date: '2026-08-06',
  },
  {
    slug: 'best-ai-content-tools-for-agencies',
    title: 'Best AI Content Tools for Agencies Managing Multiple Clients',
    description: 'Multi-client stacks for brand control, SEO QC, and research without seat waste.',
    date: '2026-08-07',
  },
];
---
<BaseLayout title="Blog" description="Research-based AI writing and SEO tool comparisons." moneyPage>
  <AffiliateDisclosure compact />
  <h1 class="mt-6 text-3xl font-bold text-slate-900">Blog</h1>
  <p class="mt-2 text-slate-600">Research-based comparisons. Not fabricated long-term trial stories.</p>
  <ul class="mt-8 space-y-4">
    {
      posts.map((p) => (
        <li class="card">
          <p class="text-xs text-slate-400">{p.date}</p>
          <h2 class="mt-1 text-xl font-semibold">
            <a href={`/blog/${p.slug}`} class="text-slate-900 no-underline hover:text-brand-600">
              {p.title}
            </a>
          </h2>
          <p class="mt-1 text-sm text-slate-600">{p.description}</p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
