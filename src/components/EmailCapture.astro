---
interface Props {
  title?: string;
  subtitle?: string;
}
const {
  title = 'Get practical tool picks',
  subtitle = 'Short emails when we publish a comparison worth reading. No spam, no hype.',
} = Astro.props;
---
<section class="card bg-gradient-to-br from-brand-50 to-white">
  <h2 class="text-xl font-bold text-slate-900">{title}</h2>
  <p class="mt-1 text-sm text-slate-600">{subtitle}</p>
  <!-- Placeholder form — wire to your ESP later; posts to /thanks for now -->
  <form action="/thanks" method="get" class="mt-4 flex flex-col gap-3 sm:flex-row">
    <label class="sr-only" for="email">Email</label>
    <input
      id="email"
      name="email"
      type="email"
      required
      placeholder="you@company.com"
      class="w-full rounded-lg border border-slate-300 px-3 py-2.5 text-sm shadow-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30"
    />
    <button type="submit" class="btn-primary whitespace-nowrap">Subscribe</button>
  </form>
  <p class="mt-2 text-xs text-slate-500">Placeholder capture — connect ConvertKit, Beehiiv, or similar before launch.</p>
</section>
