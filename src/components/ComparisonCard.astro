---
interface Props {
  href: string;
  title: string;
  subtitle: string;
  updated?: string;
}
const { href, title, subtitle, updated } = Astro.props;
---
<a href={href} class="card block no-underline transition hover:border-brand-500 hover:shadow-md">
  <h3 class="text-lg font-semibold text-slate-900">{title}</h3>
  <p class="mt-1 text-sm text-slate-600">{subtitle}</p>
  {updated && <p class="mt-3 text-xs text-slate-400">Updated {updated}</p>}
</a>
