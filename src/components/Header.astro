---
const links = [
  { href: '/start-here', label: 'Start here' },
  { href: '/tools', label: 'Tools' },
  { href: '/blog', label: 'Blog' },
  { href: '/guides', label: 'Guides' },
  { href: '/newsletter', label: 'Newsletter' },
];
const path = Astro.url.pathname;
---
<header class="border-b border-slate-200 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-4">
    <a href="/" class="flex items-center gap-2 no-underline">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-600 text-sm font-bold text-white">SP</span>
      <span class="text-base font-bold tracking-tight text-slate-900">StackPick Lab</span>
    </a>
    <nav class="hidden items-center gap-1 sm:flex" aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'rounded-md px-3 py-1.5 text-sm font-medium no-underline transition',
              path === l.href || path.startsWith(l.href + '/')
                ? 'bg-slate-100 text-slate-900'
                : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900',
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
    <a href="/newsletter" class="btn-primary text-xs sm:text-sm">Get picks</a>
  </div>
</header>
