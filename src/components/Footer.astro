  <div class="mx-auto grid max-w-5xl gap-8 px-4 py-10 sm:grid-cols-3">
    <div>
      <p class="font-bold text-slate-900">StackPick Lab</p>
      <p class="mt-2 text-sm text-slate-600">
        Practical, honest comparisons of AI writing and SEO tools for solopreneurs and small teams.
        No hype—just clear tradeoffs.
      </p>
    </div>
    <div>
      <p class="text-sm font-semibold text-slate-900">Explore</p>
      <ul class="mt-2 space-y-1 text-sm">
        <li><a href="/start-here">Start here</a></li>
        <li><a href="/tools">Tools directory</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/guides">Guides</a></li>
        <li><a href="/newsletter">Newsletter</a></li>
      </ul>
    </div>
    <div>
      <p class="text-sm font-semibold text-slate-900">Legal</p>
      <ul class="mt-2 space-y-1 text-sm">
        <li><a href="/disclosure">Affiliate disclosure</a></li>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/about">About</a></li>
