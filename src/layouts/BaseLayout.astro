---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  moneyPage?: boolean;
}
const {
  title,
  description = 'Practical, honest AI writing and SEO tool comparisons for solopreneurs and small teams.',
  moneyPage = false,
} = Astro.props;
const fullTitle = title.includes('StackPick Lab') ? title : `${title} | StackPick Lab`;
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalHref = new URL(pathname, Astro.site ?? 'https://stackpicklab.com').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{fullTitle}</title>
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8" data-money-page={moneyPage ? 'true' : undefined}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
